# Optional search / discovery APIs
TAVILY_API_KEY=

# High-ToS ingestion (dual opt-in: flag + LINKEDIN_EXPORT_PATH). Offline JSON/CSV only — see server/sources/highRisk/README.md
ENABLE_HIGH_TOS_SOURCES=
LINKEDIN_EXPORT_PATH=
LINKEDIN_RISK_MAX_ROWS=

# Optional — pipeline degrades gracefully without keys
BRAVE_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=
# Keyless metasearch (self-host recommended). Run: docker compose -f searxng/docker-compose.yml up -d
# searxng/settings.yml already enables JSON format. See searxng/README.md for details.
SEARXNG_URL=http://127.0.0.1:8081
# Optional hard caps for the SearxNG source. Per-pass budget = 80 × breadth queries / 600 × breadth results
# (1 / 2 / 4 for focused / broad / exhaustive). Defaults SEARXNG_MAX_QUERIES=200, SEARXNG_MAX_RESULTS=2000.
SEARXNG_MAX_QUERIES=
SEARXNG_MAX_RESULTS=
# DuckDuckGo HTML search needs no key. Off by default — endpoint rate-limits/blocks and stalls the source budget. Set to 1 to enable.
ENABLE_DUCKDUCKGO=
APOLLO_API_KEY=
CRUNCHBASE_API_KEY=
# GitHub org discovery — optional. Without a token the source returns nothing (graceful).
# Classic/fine-grained PAT with public read scope; raises rate limit so org websites can be resolved.
GITHUB_TOKEN=
# Holdco / acquirer-graph crawl depth for the rollup source. Recurses holdco → operating
# group → portfolio listing. Default 2 (clamped 0–3). Set 1 for the old single-level behavior.
ROLLUP_CRAWL_DEPTH=
# Max page fetches per acquirer seed (politeness ceiling; clamped to 60). Default scales
# with breadth (12 + 8×breadth). Lower it to be gentler on slow acquirer sites.
ROLLUP_PAGE_BUDGET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
# Ollama: generate targeted Brave/Serper/Exa/SearxNG queries at discovery start (default on when OLLAMA_URL set)
OLLAMA_QUERY_GEN=1
# Ollama: max generated search queries (default 80 — local inference is free, generate widely)
OLLAMA_QUERY_GEN_MAX=
# Ollama: max generated Exa (neural) queries (default 6)
OLLAMA_QUERY_GEN_EXA_MAX=
# Ollama: reject weak homepage fits after Stage A, before deep enrichment (saves scrape + paid API)
OLLAMA_PRETRIAGE=1
OLLAMA_PRETRIAGE_MIN_CONFIDENCE=0.45

# PLAYWRIGHT=1 enables headless DOM fallback on stubborn directory HTML (requires: npx playwright install chromium)
PLAYWRIGHT=
PLAYWRIGHT_BUDGET=12

PORT=3001

# When 1/true, drop discovery results that score below STRICT vertical relevance (requires industry vertical(s) selected).
STRICT_VERTICAL_FIT=
